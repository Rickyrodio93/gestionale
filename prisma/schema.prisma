generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TipoUnita {
  APPARTAMENTO
  VILLA
  LAVANDERIA
  CANTINA
  ALTRO
}

enum TipoInquilino {
  PERSONA
  SOCIETA
}

enum TipoContratto {
  LUNGO
  BREVE
}

enum TipoBolletta {
  ACQUA
  LUCE
  GAS
  ALTRO
}

enum MetodoRiparto {
  A_CARICO
  PERSONE
  CONSUMO
  EQUO
}

enum TipoValore {
  CATASTALE
  MERCATO
  PERIZIA
  OMI
  ACQUISTO
  VENDITA
}

enum ModalitaContratto {
  QUATTRO_PIU_QUATTRO
  CONCORDATO_3_2
  TRANSITORIO
  ALTRO
}

enum Canale {
  AIRBNB
  BOOKING
  DIRETTA
  ALTRO
}

enum StatoPrenotazione {
  CONFERMATA
  ANNULLATA
}

enum CategoriaSpesa {
  IMU
  CEDOLARE
  CONDOMINIO
  ORDINARIA
  STRAORDINARIA
  MUTUO
  ALTRO
}

enum Frequenza {
  MENSILE
  BIMESTRALE
  TRIMESTRALE
  SEMESTRALE
  ANNUALE
}

enum DestinazioneVersamento {
  AUTO
  CANONI
  BOLLETTE
}

enum StatoVendita {
  IN_CORSO
  CONCLUSA
  RISOLTA
}

enum TipoRataVendita {
  ANTICIPO
  RATA
  SALDO
}

model Palazzina {
  id             Int               @id @default(autoincrement())
  nome           String
  indirizzo      String?
  unita          Unita[]
  contatori      Contatore[]
  bollette       Bolletta[]
  spesas         Spesa[]
  ricorrenti     SpesaRicorrente[]
  dataAcquisto   DateTime?
  prezzoAcquisto Float?
  costiAcquisto  Float?
  dataVendita    DateTime?
  prezzoVendita  Float?
  costiVendita   Float?
  valori         ValoreImmobile[]
  vendite        VenditaRateale[]
}

model ValoreImmobile {
  id          Int        @id @default(autoincrement())
  unita       Unita?     @relation(fields: [unitaId], references: [id], onDelete: Cascade)
  unitaId     Int?
  data        DateTime
  tipo        TipoValore
  importo     Float
  fonte       String? // es. "agenzia X", "perizia geom. Y", "OMI 2° sem. 2026"
  note        String?
  palazzina   Palazzina? @relation(fields: [palazzinaId], references: [id], onDelete: Cascade)
  palazzinaId Int?
}

model Unita {
  id                Int               @id @default(autoincrement())
  palazzina         Palazzina?        @relation(fields: [palazzinaId], references: [id])
  palazzinaId       Int? // nullo = unità autonoma
  nome              String
  piano             String?
  interno           String?
  indirizzo         String? // obbligatorio se autonoma
  comune            String?
  tipo              TipoUnita         @default(APPARTAMENTO)
  catasto           DatiCatastali?
  contatori         Contatore[]
  contratti         Contratto[]
  dataAcquisto      DateTime?
  prezzoAcquisto    Float?
  dataVendita       DateTime? // se valorizzata, l'unità esce dal portafoglio attivo
  prezzoVendita     Float?
  valori            ValoreImmobile[]
  affittoBreve      Boolean           @default(false)
  gestore           String? // es. nome dell'agenzia
  icalUrl           String? // link calendario (Airbnb o principale dell'agenzia)
  cin               String? // codice identificativo nazionale, se previsto
  prenotazioni      Prenotazione[]
  incassi           Incasso[]
  spese             Spesa[]
  bollette          Bolletta[]
  ricorrenti        SpesaRicorrente[]
  costiAcquisto     Float?
  costiVendita      Float?
  icalSincronizzato DateTime?
  icalErrore        String?
  inizioMisura      DateTime?
  valoreIniziale    Float?
  venditaRateales   VenditaRateale[]
}

model DatiCatastali {
  id            Int     @id @default(autoincrement())
  unita         Unita   @relation(fields: [unitaId], references: [id], onDelete: Cascade)
  unitaId       Int     @unique
  codiceComune  String // codice catastale, es. F205
  sezione       String?
  foglio        String
  particella    String
  subalterno    String
  zonaCensuaria String?
  categoria     String // es. A/2
  classe        String
  consistenza   Float // vani o mq
  superficie    Float? // mq catastali
  rendita       Float // rendita catastale €
  quotaPossesso Float   @default(100)
  aliquotaImu   Float? // ‰ del comune, es. 10.6
}

model Inquilino {
  id         Int           @id @default(autoincrement())
  nome       String
  tipo       TipoInquilino @default(PERSONA)
  email      String?
  telefono   String?
  cfPiva     String?
  contratti  Contratto[]
  versamenti Versamento[]
}

model Contratto {
  id                   Int                  @id @default(autoincrement())
  unita                Unita                @relation(fields: [unitaId], references: [id])
  unitaId              Int
  inquilino            Inquilino            @relation(fields: [inquilinoId], references: [id])
  inquilinoId          Int
  tipo                 TipoContratto        @default(LUNGO)
  modalita             ModalitaContratto? // solo per i lunghi
  dataInizio           DateTime
  dataFine             DateTime? // scadenza corrente
  durataMesi           Int? // es. 48
  rinnovoMesi          Int? // es. 48
  preavvisoMesi        Int                  @default(6)
  rinnovi              Int                  @default(0)
  disdettaInviataIl    DateTime? // data invio comunicazione
  disdettaNote         String? // motivo, raccomandata/PEC, ecc.
  canone               Float?
  persone              Int?
  cedolare             Boolean              @default(false)
  quote                Quota[]
  inOccupazione        Boolean              @default(false)
  dataRilascio         DateTime?
  canoni               PagamentoCanone[]
  cauzione             Float?
  cauzioneVersataIl    DateTime?
  cauzioneRestituitaIl DateTime? // valorizzata = cauzione liquidata
  cauzioneRestituita   Float? // importo restituito all'inquilino
  trattenute           TrattenutaCauzione[]
  rinnovato            Boolean              @default(false)
  precedenteId         Int?
  addebiti             Addebito[]
  periodicitaMesi      Int                  @default(1)
  ancoraPeriodi        DateTime?
  aliquotaCedolare     Float?
}

// Contatore generale della palazzina (unitaId nullo) o divisionale di un'unità
model Contatore {
  id          Int          @id @default(autoincrement())
  palazzina   Palazzina    @relation(fields: [palazzinaId], references: [id])
  palazzinaId Int
  unita       Unita?       @relation(fields: [unitaId], references: [id])
  unitaId     Int?
  numero      String?
  tipo        TipoBolletta @default(ACQUA)
  letture     Lettura[]
}

model Lettura {
  id          Int       @id @default(autoincrement())
  contatore   Contatore @relation(fields: [contatoreId], references: [id])
  contatoreId Int
  data        DateTime
  valore      Float
  stimata     Boolean   @default(false)
}

model Bolletta {
  id                 Int           @id @default(autoincrement())
  palazzina          Palazzina?    @relation(fields: [palazzinaId], references: [id])
  palazzinaId        Int?
  unita              Unita?        @relation(fields: [unitaId], references: [id])
  unitaId            Int?
  tipo               TipoBolletta  @default(ACQUA)
  numero             String?
  fornitore          String?
  dal                DateTime
  al                 DateTime
  importo            Float
  metodo             MetodoRiparto @default(A_CARICO)
  dataPagamento      DateTime? // quando l'hai pagata al fornitore
  letturaGenIniziale Float?
  letturaGenFinale   Float?
  note               String?
  quote              Quota[]
}

// Quota di una bolletta a carico di un contratto
model Quota {
  id              Int         @id @default(autoincrement())
  bolletta        Bolletta    @relation(fields: [bollettaId], references: [id], onDelete: Cascade)
  bollettaId      Int
  contratto       Contratto   @relation(fields: [contrattoId], references: [id])
  contrattoId     Int
  percentuale     Float?
  importo         Float
  pagamenti       Pagamento[]
  persone         Int?
  letturaIniziale Float?
  letturaFinale   Float?
  consumo         Float?
}

model Pagamento {
  id           Int         @id @default(autoincrement())
  quota        Quota       @relation(fields: [quotaId], references: [id], onDelete: Cascade)
  quotaId      Int
  data         DateTime
  importo      Float
  daCauzione   Boolean     @default(false)
  versamento   Versamento? @relation(fields: [versamentoId], references: [id], onDelete: Cascade)
  versamentoId Int?
}

model Prenotazione {
  id                 Int               @id @default(autoincrement())
  unita              Unita             @relation(fields: [unitaId], references: [id])
  unitaId            Int
  canale             Canale            @default(ALTRO)
  uidEsterno         String? // id evento iCal, evita duplicati alla risincronizzazione
  ospite             String?
  checkIn            DateTime
  checkOut           DateTime
  stato              StatoPrenotazione @default(CONFERMATA)
  lordo              Float?
  commissioneOta     Float?
  commissioneGestore Float?
  pulizie            Float?
  ritenuta           Float?
  nettoAccreditato   Float?
  dataAccredito      DateTime?
  origine            String            @default("manuale") // manuale | ical | rendiconto
  note               String?
  blocco             Boolean           @default(false) // "non disponibile" senza dettagli (blocco o altro canale)

  @@unique([unitaId, canale, uidEsterno])
}

model Incasso {
  id      Int      @id @default(autoincrement())
  unita   Unita    @relation(fields: [unitaId], references: [id])
  unitaId Int
  data    DateTime // data di accredito
  mese    String // mese di competenza, es. "2026-10"
  importo Float // netto accreditato
  note    String?
}

model Spesa {
  id           Int              @id @default(autoincrement())
  categoria    CategoriaSpesa
  descrizione  String?
  importo      Float
  data         DateTime // data di pagamento
  anno         Int // anno di competenza (l'IMU 2026 pagata a dicembre 2026, la cedolare 2026 pagata nel 2027)
  fornitore    String?
  note         String?
  unita        Unita?           @relation(fields: [unitaId], references: [id])
  unitaId      Int?
  palazzina    Palazzina?       @relation(fields: [palazzinaId], references: [id])
  palazzinaId  Int?
  ricorrente   SpesaRicorrente? @relation(fields: [ricorrenteId], references: [id], onDelete: SetNull)
  ricorrenteId Int?
  periodo      String?
  rata         RataDilazione?   @relation(fields: [rataId], references: [id], onDelete: SetNull)
  rataId       Int?             @unique

  @@unique([ricorrenteId, periodo])
}

model PagamentoCanone {
  id           Int         @id @default(autoincrement())
  contratto    Contratto   @relation(fields: [contrattoId], references: [id], onDelete: Cascade)
  contrattoId  Int
  mese         String // competenza, es. "2026-10"
  data         DateTime // data di incasso
  importo      Float
  note         String?
  daCauzione   Boolean     @default(false)
  versamento   Versamento? @relation(fields: [versamentoId], references: [id], onDelete: Cascade)
  versamentoId Int?
}

model SpesaRicorrente {
  id                Int            @id @default(autoincrement())
  categoria         CategoriaSpesa
  descrizione       String
  importo           Float
  frequenza         Frequenza      @default(MENSILE)
  dal               DateTime
  al                DateTime?
  fornitore         String?
  note              String?
  unita             Unita?         @relation(fields: [unitaId], references: [id])
  unitaId           Int?
  palazzina         Palazzina?     @relation(fields: [palazzinaId], references: [id])
  palazzinaId       Int?
  ultimaGenerazione DateTime?
  spese             Spesa[]
  capitaleLavori    Float? // parte del prestito usata per lavori e non registrata come spesa
  dataErogazione    DateTime?
}

model TrattenutaCauzione {
  id          Int       @id @default(autoincrement())
  contratto   Contratto @relation(fields: [contrattoId], references: [id], onDelete: Cascade)
  contrattoId Int
  descrizione String
  importo     Float
  applicato   Float? // importo effettivamente trattenuto alla liquidazione
}

model Versamento {
  id           Int                    @id @default(autoincrement())
  inquilino    Inquilino              @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  inquilinoId  Int
  unitaId      Int? // vuoto = tutte le unità dell'inquilino
  data         DateTime
  importo      Float
  destinazione DestinazioneVersamento @default(AUTO)
  note         String?
  canoni       PagamentoCanone[]
  pagamenti    Pagamento[]
  pagAddebiti  PagamentoAddebito[]
}

// spese a carico dell'inquilino: raccomandata, marca da bollo, penali…
model Addebito {
  id          Int                 @id @default(autoincrement())
  contratto   Contratto           @relation(fields: [contrattoId], references: [id], onDelete: Cascade)
  contrattoId Int
  data        DateTime
  descrizione String
  importo     Float
  pagamenti   PagamentoAddebito[]
}

model PagamentoAddebito {
  id           Int         @id @default(autoincrement())
  addebito     Addebito    @relation(fields: [addebitoId], references: [id], onDelete: Cascade)
  addebitoId   Int
  versamento   Versamento? @relation(fields: [versamentoId], references: [id], onDelete: Cascade)
  versamentoId Int?
  data         DateTime
  importo      Float
}

model DilazioneImposta {
  id                Int             @id @default(autoincrement())
  descrizione       String
  anno              Int // anno d'imposta a cui si riferisce
  impostaOriginaria Float // imposta coperta dal piano, senza interessi e sanzioni
  note              String?
  rate              RataDilazione[]
}

model RataDilazione {
  id          Int              @id @default(autoincrement())
  dilazione   DilazioneImposta @relation(fields: [dilazioneId], references: [id], onDelete: Cascade)
  dilazioneId Int
  numero      Int
  scadenza    DateTime
  importo     Float
  pagataIl    DateTime?
  spesa       Spesa?
}

model VenditaRateale {
  id           Int              @id @default(autoincrement())
  palazzina    Palazzina?       @relation(fields: [palazzinaId], references: [id])
  palazzinaId  Int?
  unita        Unita?           @relation(fields: [unitaId], references: [id])
  unitaId      Int?
  acquirente   String
  dataFirma    DateTime
  prezzo       Float
  costiVendita Float? // agenzia, notaio e altri costi a tuo carico
  stato        StatoVendita     @default(IN_CORSO)
  dataRogito   DateTime? // prevista, poi effettiva
  dataChiusura DateTime? // rogito o risoluzione
  trattenuto   Float? // se risolta: quanto resta a te
  note         String?
  rate         RataVendita[]
  incassi      IncassoVendita[]
}

model RataVendita {
  id        Int             @id @default(autoincrement())
  vendita   VenditaRateale  @relation(fields: [venditaId], references: [id], onDelete: Cascade)
  venditaId Int
  tipo      TipoRataVendita @default(RATA)
  scadenza  DateTime
  importo   Float
}

model IncassoVendita {
  id        Int            @id @default(autoincrement())
  vendita   VenditaRateale @relation(fields: [venditaId], references: [id], onDelete: Cascade)
  venditaId Int
  data      DateTime
  importo   Float
  note      String?
}
